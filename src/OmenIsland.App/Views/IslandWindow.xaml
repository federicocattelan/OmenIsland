<Window x:Class="OmenIsland.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:OmenIsland.App.Presentation"
        xmlns:views="clr-namespace:OmenIsland.App.Views"
        Title="Omen Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="220"
        Height="7"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <SolidColorBrush x:Key="ShellBrush" Color="Black" />
        <SolidColorBrush x:Key="ShellRaisedBrush" Color="#161616" />
        <Style x:Key="ShellButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IslandButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ShellRaisedBrush}" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
        </Style>
        <Style x:Key="ExpandedProfileIconStyle" TargetType="Button" BasedOn="{StaticResource ProfileIconStyle}">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <Border x:Name="Plate"
                                    Width="46"
                                    Height="46"
                                    CornerRadius="12"
                                    Background="#18FFFFFF"
                                    HorizontalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="Caption"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="12,8" />
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>
        <presentation:ProgressWidthConverter x:Key="ProgressWidthConverter" />
        <Style x:Key="ThinProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="3">
                            <Border CornerRadius="1.5" Background="{TemplateBinding Background}" />
                            <Canvas ClipToBounds="True">
                                <Border Height="3"
                                        CornerRadius="1.5"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Canvas>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandSliderStyle" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Margin="0,6">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5" Background="{DynamicResource IslandActiveBrush}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5" Background="#26FFFFFF" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="10" Height="10" Fill="{DynamicResource IslandActiveBrush}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootHost" Background="Transparent">
        <Border x:Name="IslandSurface"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="{StaticResource IslandSurfaceBrush}"
                BorderBrush="{StaticResource IslandStrokeBrush}"
                BorderThickness="0"
                CornerRadius="0,0,16,16"
                MouseEnter="IslandSurface_MouseEnter"
                MouseLeave="IslandSurface_MouseLeave"
                PreviewMouseLeftButtonUp="IslandSurface_MouseLeftButtonUp">
            <Grid>
                <Grid x:Name="IdleView" Height="7" VerticalAlignment="Top">
                    <Border x:Name="IdleLine"
                            Height="3"
                            VerticalAlignment="Top"
                            Margin="8,0"
                            CornerRadius="0,0,3,3"
                            Background="Black" />
                </Grid>

                <StackPanel x:Name="CompactView"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            Margin="14,8,14,10"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0"
                                    ToolTip="Temperatura CPU">
                            <TextBlock Text="&#xEEA1;"
                                       Style="{StaticResource FluentIconStyle}"
                                       ToolTip="CPU" />
                            <TextBlock Text="{Binding CpuTemperatureText}"
                                       Width="58"
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0"
                                    ToolTip="Temperatura GPU">
                            <TextBlock Text="&#xE7FC;"
                                       Style="{StaticResource FluentIconStyle}"
                                       ToolTip="GPU" />
                            <TextBlock Text="{Binding GpuTemperatureText}"
                                       Width="58"
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    ToolTip="Uso RAM">
                            <TextBlock Text="&#xEEA0;"
                                       Style="{StaticResource FluentIconStyle}"
                                       ToolTip="RAM" />
                            <TextBlock Text="{Binding MemoryText}"
                                       Width="48"
                                       Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource SectionDividerStyle}" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button ToolTip="Eco"
                                Command="{Binding SetProfileCommand}"
                                CommandParameter="Eco">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ProfileIconStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfile}" Value="Eco">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE8BE;" Style="{StaticResource FluentGlyphStyle}" />
                        </Button>
                        <Button ToolTip="Silenzioso"
                                Command="{Binding SetProfileCommand}"
                                CommandParameter="Quiet">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ProfileIconStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfile}" Value="Quiet">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE708;" Style="{StaticResource FluentGlyphStyle}" />
                        </Button>
                        <Button ToolTip="Predefinita"
                                Command="{Binding SetProfileCommand}"
                                CommandParameter="Default">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ProfileIconStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfile}" Value="Default">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xEA3A;" Style="{StaticResource FluentGlyphStyle}" />
                        </Button>
                        <Button ToolTip="Performance"
                                Command="{Binding SetProfileCommand}"
                                CommandParameter="Performance">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ProfileIconStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfile}" Value="Performance">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE945;" Style="{StaticResource FluentGlyphStyle}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NowPlaying.IsActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource SectionDividerStyle}" />
                        <Grid Width="290" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="6" ClipToBounds="True"
                                    Background="{DynamicResource ShellRaisedBrush}">
                                <Grid>
                                    <TextBlock Text="&#xE189;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="14"
                                               Foreground="{StaticResource IslandMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Width="32" Height="32" Stretch="UniformToFill"
                                           Source="{Binding NowPlaying.Artwork}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,2,0" VerticalAlignment="Center">
                                <views:CompactTrackLayout>
                                <TextBlock views:CompactTrackLayout.Slot="Title"
                                           Text="{Binding NowPlaying.Title}"
                                           Foreground="{StaticResource IslandTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock views:CompactTrackLayout.Slot="Artist"
                                           Text="{Binding NowPlaying.Artist}"
                                           Foreground="{StaticResource IslandMutedBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1,6,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NowPlaying.ShowVisualizer}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel views:CompactTrackLayout.Slot="Controls"
                                            Orientation="Horizontal"
                                            Width="54"
                                            VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NowPlaying.ShowVisualizer}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Width="16"
                                            Height="16"
                                            Padding="0"
                                            ToolTip="Indietro"
                                            Command="{Binding NowPlaying.PreviousCommand}"
                                            Style="{StaticResource MediaButtonStyle}">
                                        <TextBlock Text="&#xE892;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="11"
                                                   Foreground="{StaticResource IslandTextBrush}" />
                                    </Button>
                                    <Button Width="18"
                                            Height="16"
                                            Padding="0"
                                            Margin="2,0"
                                            ToolTip="Play o pausa"
                                            Command="{Binding NowPlaying.TogglePlayCommand}"
                                            Style="{StaticResource MediaButtonStyle}">
                                        <TextBlock Text="{Binding NowPlaying.PlayGlyph}"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource IslandActiveBrush}" />
                                    </Button>
                                    <Button Width="16"
                                            Height="16"
                                            Padding="0"
                                            ToolTip="Avanti"
                                            Command="{Binding NowPlaying.NextCommand}"
                                            Style="{StaticResource MediaButtonStyle}">
                                        <TextBlock Text="&#xE893;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="11"
                                                   Foreground="{StaticResource IslandTextBrush}" />
                                    </Button>
                                </StackPanel>
                                <TextBlock views:CompactTrackLayout.Slot="Elapsed"
                                           Text="{Binding NowPlaying.ElapsedText}"
                                           TextAlignment="Right"
                                           Foreground="{StaticResource IslandMutedBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NowPlaying.ShowVisualizer}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock views:CompactTrackLayout.Slot="Duration"
                                           Text="{Binding NowPlaying.DurationText}"
                                           TextAlignment="Right"
                                           Foreground="{StaticResource IslandMutedBrush}"
                                           FontSize="10"
                                           Margin="0,1,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NowPlaying.ShowVisualizer}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </views:CompactTrackLayout>
                                <ProgressBar Height="3"
                                             Margin="0,4,0,0"
                                             Value="{Binding NowPlaying.Progress, Mode=OneWay}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource ThinProgressStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NowPlaying.ShowVisualizer}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <views:WaveformBars Height="20"
                                                    Margin="0,4,0,0"
                                                    VerticalAlignment="Center"
                                                    BarBrush="{DynamicResource IslandActiveBrush}"
                                                    IsCapturing="{Binding NowPlaying.ShowVisualizer}"
                                                    TargetProcessId="{Binding NowPlaying.ActiveProcessId}">
                                    <views:WaveformBars.Style>
                                        <Style TargetType="views:WaveformBars">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NowPlaying.ShowVisualizer}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:WaveformBars.Style>
                                </views:WaveformBars>
                            </StackPanel>
                        </Grid>
                        <Button Width="22"
                                Height="32"
                                Margin="8,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                ToolTip="Spettro"
                                Style="{StaticResource MediaButtonStyle}"
                                Command="{Binding NowPlaying.ToggleVisualizerCommand}">
                            <StackPanel Orientation="Horizontal" Height="14" VerticalAlignment="Center">
                                <Border Width="2" Height="5" Margin="0.6,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource IslandActiveBrush}" />
                                <Border Width="2" Height="9" Margin="0.6,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource IslandActiveBrush}" />
                                <Border Width="2" Height="14" Margin="0.6,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource IslandActiveBrush}" />
                                <Border Width="2" Height="8" Margin="0.6,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource IslandActiveBrush}" />
                                <Border Width="2" Height="4" Margin="0.6,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource IslandActiveBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource SectionDividerStyle}" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Width="42" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Calendar.WeekdayText}"
                                       Foreground="{DynamicResource IslandActiveBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Calendar.DayNumber}"
                                       Foreground="{StaticResource IslandTextBrush}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,-2,0,0" />
                        </StackPanel>
                        <Border Width="1" Margin="8,6" Background="#26FFFFFF">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Calendar.HasCompactEvent}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel Width="148" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Calendar.HasCompactEvent}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Calendar.CompactEventTime}"
                                       Foreground="{StaticResource IslandMutedBrush}"
                                       FontSize="11" />
                            <TextBlock Text="{Binding Calendar.CompactEventTitle}"
                                       Foreground="{StaticResource IslandTextBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ExpandedView"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            Margin="14,14,14,12">
                    <StackPanel x:Name="PlayerColumn" VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Width" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NowPlaying.IsActive}" Value="True">
                                        <Setter Property="Width" Value="220" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource MediaButtonStyle}" />
                        </StackPanel.Resources>
                        <TextBlock Text="Nessuna riproduzione"
                                   Foreground="{StaticResource IslandMutedBrush}"
                                   FontSize="13"
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.IsActive}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.IsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="220" Height="220" CornerRadius="10" ClipToBounds="True"
                                    Background="{DynamicResource ShellRaisedBrush}">
                                <Grid>
                                    <TextBlock Text="&#xE189;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="28"
                                               Foreground="{StaticResource IslandMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowPlaying.ShowTerrain}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Stretch="UniformToFill"
                                           Source="{Binding NowPlaying.Artwork}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowPlaying.ShowTerrain}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <views:TopographicRibbon
                                        LineBrush="{DynamicResource IslandActiveBrush}"
                                        IsCapturing="{Binding NowPlaying.ShowTerrain}"
                                        TargetProcessId="{Binding NowPlaying.ActiveProcessId}">
                                        <views:TopographicRibbon.Style>
                                            <Style TargetType="views:TopographicRibbon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowPlaying.ShowTerrain}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </views:TopographicRibbon.Style>
                                    </views:TopographicRibbon>
                                    <Button Width="32"
                                            Height="32"
                                            Margin="0,8,8,0"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Panel.ZIndex="2"
                                            Cursor="Hand"
                                            Focusable="False"
                                            Command="{Binding NowPlaying.ToggleTerrainCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MediaButtonStyle}">
                                                <Setter Property="ToolTip" Value="Visualizzatore" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowPlaying.IsTerrainOpen}" Value="True">
                                                        <Setter Property="ToolTip" Value="Copertina" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid Width="32" Height="32">
                                            <Border CornerRadius="16" Background="#CC101216" />
                                            <StackPanel Orientation="Horizontal"
                                                        Height="14"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NowPlaying.IsTerrainOpen}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Border Width="2" Height="6" Margin="0.7,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource IslandActiveBrush}" />
                                                <Border Width="2" Height="11" Margin="0.7,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource IslandActiveBrush}" />
                                                <Border Width="2" Height="14" Margin="0.7,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource IslandActiveBrush}" />
                                                <Border Width="2" Height="8" Margin="0.7,0" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource IslandActiveBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="&#xEB9F;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource IslandActiveBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NowPlaying.IsTerrainOpen}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding NowPlaying.Title}"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource IslandTextBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding NowPlaying.Artist}"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource IslandMutedBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding NowPlaying.ElapsedText}"
                                           Foreground="{StaticResource IslandMutedBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center" />
                                <Slider x:Name="PositionSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource IslandSliderStyle}"
                                        Minimum="0"
                                        Maximum="{Binding NowPlaying.DurationSeconds}"
                                        Value="{Binding NowPlaying.PositionSeconds, Mode=TwoWay}"
                                        IsEnabled="{Binding NowPlaying.IsActive}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding NowPlaying.DurationText}"
                                           Foreground="{StaticResource IslandMutedBrush}"
                                           FontSize="10"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,8,0,0" Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding NowPlaying.ToggleShuffleCommand}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Center" IsEnabled="{Binding NowPlaying.IsActive}">
                                    <TextBlock Text="&#xE8B1;" FontFamily="Segoe Fluent Icons" FontSize="14" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource IslandMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowPlaying.IsShuffleOn}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding NowPlaying.PreviousCommand}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Center" IsEnabled="{Binding NowPlaying.IsActive}">
                                    <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                               Foreground="{StaticResource IslandTextBrush}" HorizontalAlignment="Center" />
                                </Button>
                                <Button Grid.Column="2" Width="38" Height="38"
                                        Command="{Binding NowPlaying.TogglePlayCommand}"
                                        Cursor="Hand" BorderThickness="0"
                                        FocusVisualStyle="{x:Null}"
                                        IsEnabled="{Binding NowPlaying.IsActive}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource ShellRaisedBrush}">
                                                <TextBlock Text="{Binding NowPlaying.PlayGlyph}"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource IslandActiveBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding NowPlaying.NextCommand}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Center" IsEnabled="{Binding NowPlaying.IsActive}">
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                               Foreground="{StaticResource IslandTextBrush}" HorizontalAlignment="Center" />
                                </Button>
                                <Button Grid.Column="4" Command="{Binding NowPlaying.CycleRepeatCommand}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Center" IsEnabled="{Binding NowPlaying.IsActive}">
                                    <TextBlock Text="{Binding NowPlaying.RepeatGlyph}" FontFamily="Segoe Fluent Icons" FontSize="14" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource IslandMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowPlaying.IsRepeatOn}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE992;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                           Foreground="{StaticResource IslandMutedBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="VolumeSlider" Grid.Column="1" Margin="8,0"
                                        Style="{StaticResource IslandSliderStyle}"
                                        Minimum="0" Maximum="100"
                                        Value="{Binding NowPlaying.Volume, Mode=TwoWay}"
                                        IsEnabled="{Binding NowPlaying.HasVolume}" />
                                <TextBlock Grid.Column="2" Text="&#xE995;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                           Foreground="{StaticResource IslandMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NowPlaying.IsActive}" Value="True">
                                        <Setter Property="Width" Value="16" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Grid Width="360" VerticalAlignment="Top" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="96" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <UniformGrid x:Name="ProfileRow" Rows="1">
                        <Button x:Name="ProfileEco"
                                Tag="Eco"
                                ToolTip="Eco"
                                Command="{Binding SetProfileCommand}"
                                CommandParameter="Eco">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExpandedProfileIconStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfile}" Value="Eco">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE8BE;" Style="{StaticResource FluentGlyphStyle}" FontSize="20" />
                        </Button>
                        <Button x:Name="ProfileQuiet"
                                Tag="Silenzioso"
                                ToolTip="Silenzioso"
                                Command="{Binding SetProfileCommand}"
                                CommandParameter="Quiet">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExpandedProfileIconStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfile}" Value="Quiet">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE708;" Style="{StaticResource FluentGlyphStyle}" FontSize="20" />
                        </Button>
                        <Button x:Name="ProfileDefault"
                                Tag="Predefinita"
                                ToolTip="Predefinita"
                                Command="{Binding SetProfileCommand}"
                                CommandParameter="Default">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExpandedProfileIconStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfile}" Value="Default">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xEA3A;" Style="{StaticResource FluentGlyphStyle}" FontSize="20" />
                        </Button>
                        <Button x:Name="ProfilePerformance"
                                Tag="Performance"
                                ToolTip="Performance"
                                Command="{Binding SetProfileCommand}"
                                CommandParameter="Performance">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExpandedProfileIconStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveProfile}" Value="Performance">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE945;" Style="{StaticResource FluentGlyphStyle}" FontSize="20" />
                        </Button>
                    </UniformGrid>

                    <Grid x:Name="MetricRow" Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MetricCpu"
                                Grid.Column="0"
                                Background="{DynamicResource ShellRaisedBrush}"
                                CornerRadius="10"
                                Margin="0,0,4,0"
                                Padding="10,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                    <TextBlock Text="&#xEEA1;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="14"
                                               Foreground="{StaticResource IslandMutedBrush}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="CPU"
                                               Style="{StaticResource MetricLabelStyle}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding CpuTemperatureText}"
                                           Width="84"
                                           TextAlignment="Right"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource IslandTextBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <Border x:Name="MetricGpu"
                                Grid.Column="1"
                                Background="{DynamicResource ShellRaisedBrush}"
                                CornerRadius="10"
                                Margin="0,0,4,0"
                                Padding="10,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                    <TextBlock Text="&#xE7FC;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="14"
                                               Foreground="{StaticResource IslandMutedBrush}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="GPU"
                                               Style="{StaticResource MetricLabelStyle}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding GpuTemperatureText}"
                                           Width="84"
                                           TextAlignment="Right"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource IslandTextBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <Border x:Name="MetricRam"
                                Grid.Column="2"
                                Background="{DynamicResource ShellRaisedBrush}"
                                CornerRadius="10"
                                Padding="10,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                    <TextBlock Text="&#xEEA0;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="14"
                                               Foreground="{StaticResource IslandMutedBrush}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="RAM"
                                               Style="{StaticResource MetricLabelStyle}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding MemoryText}"
                                           Width="64"
                                           TextAlignment="Right"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource IslandTextBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="FanRow" Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock Text="VENTOLE"
                                   Style="{StaticResource MetricLabelStyle}"
                                   Margin="2,0,0,8" />
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource ShellRaisedBrush}"
                                CornerRadius="10"
                                Padding="4"
                                MinHeight="52"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Auto"
                                        Command="{Binding SetFanModeCommand}"
                                        CommandParameter="Auto"
                                        MinWidth="56"
                                        MinHeight="44"
                                        Margin="0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ShellButtonStyle}">
                                            <Setter Property="Padding" Value="12,10" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveFanMode}" Value="Auto">
                                                    <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource IslandActiveBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Max"
                                        Command="{Binding SetFanModeCommand}"
                                        CommandParameter="Max"
                                        MinWidth="56"
                                        MinHeight="44"
                                        Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ShellButtonStyle}">
                                            <Setter Property="Padding" Value="12,10" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveFanMode}" Value="Max">
                                                    <Setter Property="Foreground" Value="{DynamicResource IslandActiveBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource IslandActiveBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Margin="8,0,0,0"
                                Padding="10,10"
                                MinHeight="52"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="#14FFFFFF">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU"
                                           Style="{StaticResource MetricLabelStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CpuFanText}"
                                           Width="42"
                                           Margin="6,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource IslandTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="GPU"
                                           Style="{StaticResource MetricLabelStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GpuFanText}"
                                           Width="42"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource IslandTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <Button Grid.Column="1"
                                ToolTip="Impostazioni"
                                Width="36"
                                Height="36"
                                Margin="8,0,0,0"
                                Click="OpenSettings_Click"
                                Style="{StaticResource MediaButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Foreground="{StaticResource IslandMutedBrush}" />
                        </Button>
                        </Grid>
                    </StackPanel>
                    </Grid>

                    <Border Width="16" />
                    <Grid x:Name="CalendarColumn" Width="210" VerticalAlignment="Stretch">
                        <Grid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource MediaButtonStyle}" />
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Height="24">
                            <Button HorizontalAlignment="Left" Width="24" Height="24"
                                    Command="{Binding Calendar.PreviousMonthCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                           Foreground="{StaticResource IslandTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock Text="{Binding Calendar.MonthLabel}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource IslandTextBrush}"
                                       FontSize="13" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Right" Width="24" Height="24"
                                    Command="{Binding Calendar.NextMonthCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                           Foreground="{StaticResource IslandTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="7" Margin="0,8,0,2">
                            <TextBlock Text="Lu" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource IslandMutedBrush}" />
                            <TextBlock Text="Ma" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource IslandMutedBrush}" />
                            <TextBlock Text="Me" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource IslandMutedBrush}" />
                            <TextBlock Text="Gi" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource IslandMutedBrush}" />
                            <TextBlock Text="Ve" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource IslandMutedBrush}" />
                            <TextBlock Text="Sa" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource IslandMutedBrush}" />
                            <TextBlock Text="Do" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource IslandMutedBrush}" />
                        </UniformGrid>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Calendar.Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.Calendar.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="0"
                                            Margin="0,1"
                                            HorizontalAlignment="Center"
                                            FocusVisualStyle="{x:Null}"
                                            Cursor="Hand">
                                        <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#66FFFFFF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#CCFFFFFF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource IslandActiveBrush}" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Day}" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource IslandMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding InMonth}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource IslandTextBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF141519" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="3" Text="{Binding Calendar.SelectedHeading}" Style="{StaticResource MetricLabelStyle}" Margin="2,12,0,0" />
                        <StackPanel Grid.Row="4" Margin="0,6,0,0">
                                <TextBlock Text="Collega Google Calendar dalle impostazioni."
                                           Foreground="{StaticResource IslandMutedBrush}"
                                           FontSize="12" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Calendar.IsConnected}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Nessun evento."
                                           Foreground="{StaticResource IslandMutedBrush}"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Calendar.IsConnected}" Value="True" />
                                                        <Condition Binding="{Binding Calendar.HasSelectedEvents}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Calendar.StatusText}"
                                           Foreground="{StaticResource IslandMutedBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding Calendar.TodayEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,6,0,0" Padding="8,6" CornerRadius="8"
                                                    Background="{DynamicResource ShellRaisedBrush}">
                                                <Grid>
                                                    <Border Width="3" HorizontalAlignment="Left" CornerRadius="2"
                                                            Background="{DynamicResource IslandActiveBrush}" />
                                                    <StackPanel Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{StaticResource IslandTextBrush}"
                                                                   FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding TimeText}"
                                                                   Foreground="{StaticResource IslandMutedBrush}"
                                                                   FontSize="11" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding ShownDescription}"
                                                                   Foreground="{StaticResource IslandTextBrush}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Description}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Button Content="{Binding DescriptionToggleText}"
                                                                Command="{Binding DataContext.Calendar.ToggleDescriptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,6,0,0"
                                                                Padding="0"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource IslandActiveBrush}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource MediaButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanExpand}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
